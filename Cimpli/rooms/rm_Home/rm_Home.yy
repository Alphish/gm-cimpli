            {"$GMOverriddenProperty":"v1","%Name":"","name":"","objectId":{"name":"ui_ActionButton","path":"objects/ui_ActionButton/ui_ActionButton.yy",},"propertyId":{"name":"text","path":"objects/ui_ActionButton/ui_ActionButton.yy",},"resourceType":"GMOverriddenProperty","resourceVersion":"2.0","value":"Docs",},
