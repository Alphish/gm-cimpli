            {"$GMOverriddenProperty":"v1","%Name":"","name":"","objectId":{"name":"ui_ActionButton","path":"objects/ui_ActionButton/ui_ActionButton.yy",},"propertyId":{"name":"command_parameter","path":"objects/ui_ActionButton/ui_ActionButton.yy",},"resourceType":"GMOverriddenProperty","resourceVersion":"2.0","value":"\"https://github.com/Alphish/gm-cimpli/blob/main/Docs/05-Workers.md\"",},
            {"$GMOverriddenProperty":"v1","%Name":"","name":"","objectId":{"name":"ui_ActionButton","path":"objects/ui_ActionButton/ui_ActionButton.yy",},"propertyId":{"name":"command","path":"objects/ui_ActionButton/ui_ActionButton.yy",},"resourceType":"GMOverriddenProperty","resourceVersion":"2.0","value":"url_open",},
          ],"resourceType":"GMRInstance","resourceVersion":"2.0","rotation":0.0,"scaleX":1.3333337,"scaleY":0.6667,"x":280.0,"y":320.0,},
        {"$GMRInstance":"v4","%Name":"inst_140A5A74","colour":4292149119,"frozen":false,"hasCreationCode":true,"ignore":false,"imageIndex":0,"imageSpeed":1.0,"inheritCode":false,"inheritedItemId":null,"inheritItemSettings":false,"isDnd":false,"name":"inst_140A5A74","objectId":{"name":"ui_ActionButton","path":"objects/ui_ActionButton/ui_ActionButton.yy",},"properties":[
            {"$GMOverriddenProperty":"v1","%Name":"","name":"","objectId":{"name":"ui_ActionButton","path":"objects/ui_ActionButton/ui_ActionButton.yy",},"propertyId":{"name":"text","path":"objects/ui_ActionButton/ui_ActionButton.yy",},"resourceType":"GMOverriddenProperty","resourceVersion":"2.0","value":"Quit",},
            {"$GMOverriddenProperty":"v1","%Name":"","name":"","objectId":{"name":"ui_ActionButton","path":"objects/ui_ActionButton/ui_ActionButton.yy",},"propertyId":{"name":"hover_color","path":"objects/ui_ActionButton/ui_ActionButton.yy",},"resourceType":"GMOverriddenProperty","resourceVersion":"2.0","value":"$FFAAFF00",},
            {"$GMOverriddenProperty":"v1","%Name":"","name":"","objectId":{"name":"ui_ActionButton","path":"objects/ui_ActionButton/ui_ActionButton.yy",},"propertyId":{"name":"command","path":"objects/ui_ActionButton/ui_ActionButton.yy",},"resourceType":"GMOverriddenProperty","resourceVersion":"2.0","value":"function() { game_end(); }",},
          ],"resourceType":"GMRInstance","resourceVersion":"2.0","rotation":0.0,"scaleX":4.0000005,"scaleY":0.6667,"x":80.0,"y":640.0,},
      ],"layers":[],"name":"Instances","properties":[],"resourceType":"GMRInstanceLayer","resourceVersion":"2.0","userdefinedDepth":false,"visible":true,},
    {"$GMRAssetLayer":"","%Name":"Info_Intro","assets":[
        {"$GMRTextItem":"v3","%Name":"text_3EB9EF7D","alignment":0,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"fnt_Info","path":"fonts/fnt_Info/fnt_Info.yy",},"frameH":600.0,"frameW":840.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":5.0,"name":"text_3EB9EF7D","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"CIMPLI - or Common Implementations Library - contains basic implementations of frequently reused systems.\r\n\r\nThese implementations should handle most basic needs; if needed, the game may easily replace such basic implementations with more advanced, as long as it has a matching structure (interface) in terms of variables and methods.\r\n\r\nCIMPLI implements the following systems:\r\n- Events - for separating checks logic from  the outcome handling logic\r\n- Commands - for wrapping the executable logic to use in components triggering it\r\n- Properties - for wrapping individual values and tracking their changes\r\n- Logging - for storing diagnostic messages of varying importance\r\n- Worker - for executing long-running logic over multiple frames without blocking the game\r\n- Providers - for delivering values of a requested kind, with optional parameters\r\n\r\nYou can read more about each system in its corresponding section or the documentation page.\r\n\r\nThere are also two demonstrations available:\r\n- Counter Observer: focusing on events, logging and worker systems\r\n- Shape Maker: focusing on the providers system\r\n\r\nMoreover, the commands system is used across action buttons, while the properties system is used across selection buttons.","wrap":true,"x":420.0,"y":80.0,},
        {"$GMRTextItem":"v3","%Name":"text_6FA98FF7","alignment":0,"charSpacing":0.0,"colour":4292149119,"fontId":{"name":"fnt_Title","path":"fonts/fnt_Title/fnt_Title.yy",},"frameH":40.0,"frameW":800.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":5.0,"name":"text_6FA98FF7","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"INTRODUCTION","wrap":true,"x":420.0,"y":20.0,},
      ],"depth":100,"effectEnabled":true,"effectType":null,"gridX":20,"gridY":20,"hierarchyFrozen":false,"inheritLayerDepth":false,"inheritLayerSettings":false,"inheritSubLayers":true,"inheritVisibility":true,"layers":[],"name":"Info_Intro","properties":[],"resourceType":"GMRAssetLayer","resourceVersion":"2.0","userdefinedDepth":false,"visible":true,},
    {"$GMRAssetLayer":"","%Name":"Info_Events","assets":[
        {"$GMRTextItem":"v3","%Name":"text_739D1483","alignment":0,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"fnt_Info","path":"fonts/fnt_Info/fnt_Info.yy",},"frameH":600.0,"frameW":840.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":5.0,"name":"text_739D1483","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"The events system allows different entities to coordinate without a direct connection.\r\nMore specifically, one entity may expose an event subject others can subscribe to.\r\nThen other entities may subscribe to the event subject to receive events sent by it.\r\n\r\nFor example, the gameplay manager object may keep track of enemies defeated and send an event every time the count of enemies defeated increases.\r\nThen a UI component may keep observe this event and update the count whenever needed.\r\nAdditionally, an achievements system may independently observe this event in order to grant the achievement after defeating a specific number of enemies.\r\nImportantly, the enemies defeated counter doesn't need to be designed around the presence or lack of these UI and achievement systems - its only job is to keep track of enemies defeated and sending the information to whichever systems require it.\r\n\r\nThe events system includes two main components:\r\n- the event subject, which sends events and can be subscribed to\r\n- the event observer, which receives and handles the incoming events\r\n\r\nThe events system is showcased in the Counter Observer Demo, where you can add and remove observers to and from various subjects.","wrap":true,"x":420.0,"y":80.0,},
        {"$GMRTextItem":"v3","%Name":"text_47363328","alignment":0,"charSpacing":0.0,"colour":4292149119,"fontId":{"name":"fnt_Title","path":"fonts/fnt_Title/fnt_Title.yy",},"frameH":40.0,"frameW":800.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":5.0,"name":"text_47363328","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"EVENTS SYSTEM","wrap":true,"x":420.0,"y":20.0,},
      ],"depth":200,"effectEnabled":true,"effectType":null,"gridX":20,"gridY":20,"hierarchyFrozen":false,"inheritLayerDepth":false,"inheritLayerSettings":false,"inheritSubLayers":true,"inheritVisibility":true,"layers":[],"name":"Info_Events","properties":[],"resourceType":"GMRAssetLayer","resourceVersion":"2.0","userdefinedDepth":false,"visible":false,},
    {"$GMRAssetLayer":"","%Name":"Info_Commands","assets":[
        {"$GMRTextItem":"v3","%Name":"text_6D4A380D","alignment":0,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"fnt_Info","path":"fonts/fnt_Info/fnt_Info.yy",},"frameH":600.0,"frameW":840.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":5.0,"name":"text_6D4A380D","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"Commands specify bits of logic to execute and under what conditions execution is possible. Such a command can be linked to a mouse-clicked button, a hotkey combination, a cheat console command etc.; what causes the command to be executed is beyond the scope of the command itself.\r\n\r\nThe commands are showcased across all demonstrations, being linked to various buttons. Additionally, if a command cannot be executed, the button linked to it will be disabled and greyed out.","wrap":true,"x":420.0,"y":80.0,},
        {"$GMRTextItem":"v3","%Name":"text_1E4106F5","alignment":0,"charSpacing":0.0,"colour":4292149119,"fontId":{"name":"fnt_Title","path":"fonts/fnt_Title/fnt_Title.yy",},"frameH":40.0,"frameW":800.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":5.0,"name":"text_1E4106F5","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"COMMANDS SYSTEM","wrap":true,"x":420.0,"y":20.0,},
      ],"depth":300,"effectEnabled":true,"effectType":null,"gridX":20,"gridY":20,"hierarchyFrozen":false,"inheritLayerDepth":false,"inheritLayerSettings":false,"inheritSubLayers":true,"inheritVisibility":true,"layers":[],"name":"Info_Commands","properties":[],"resourceType":"GMRAssetLayer","resourceVersion":"2.0","userdefinedDepth":false,"visible":false,},
    {"$GMRAssetLayer":"","%Name":"Info_Properties","assets":[
        {"$GMRTextItem":"v3","%Name":"text_2BE998DD","alignment":0,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"fnt_Info","path":"fonts/fnt_Info/fnt_Info.yy",},"frameH":600.0,"frameW":840.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":5.0,"name":"text_2BE998DD","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"Properties are used for managing values - getting and setting them, as well as sending events when the underlying value has been changed (see also: Events System).\r\nIn particular, managing values through the properties system allows different components to receive up-to-date values without having to directly coordinate between one another.\r\n\r\nThe properties are showcased across all demonstrations, being linked to selection buttons.\r\nWhen such a button is clicked, it sets the value of its underlying property.","wrap":true,"x":420.0,"y":80.0,},
        {"$GMRTextItem":"v3","%Name":"text_403F0C46","alignment":0,"charSpacing":0.0,"colour":4292149119,"fontId":{"name":"fnt_Title","path":"fonts/fnt_Title/fnt_Title.yy",},"frameH":40.0,"frameW":840.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":5.0,"name":"text_403F0C46","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"PROPERTIES SYSTEM","wrap":true,"x":420.0,"y":20.0,},
      ],"depth":400,"effectEnabled":true,"effectType":null,"gridX":20,"gridY":20,"hierarchyFrozen":false,"inheritLayerDepth":false,"inheritLayerSettings":false,"inheritSubLayers":true,"inheritVisibility":true,"layers":[],"name":"Info_Properties","properties":[],"resourceType":"GMRAssetLayer","resourceVersion":"2.0","userdefinedDepth":false,"visible":false,},
    {"$GMRAssetLayer":"","%Name":"Info_Logging","assets":[
        {"$GMRTextItem":"v3","%Name":"text_53C8CAB0","alignment":0,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"fnt_Info","path":"fonts/fnt_Info/fnt_Info.yy",},"frameH":600.0,"frameW":840.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":5.0,"name":"text_53C8CAB0","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"The logging system is used for keeping track of various occurrences and general game state throughout the game runtime. Most of the time, logging isn't really used for gameplay itself, but it's useful for making sure the general state is correct, diagnosing problems or sending warnings about potential problem.\r\n\r\nThe logging system is showcased in the Counter Observer Demo, where different events generate log messages of various kinds and importance. The demonstration also allows changing the importance threshold of messages to be reported.","wrap":true,"x":420.0,"y":80.0,},
        {"$GMRTextItem":"v3","%Name":"text_6454E288","alignment":0,"charSpacing":0.0,"colour":4292149119,"fontId":{"name":"fnt_Title","path":"fonts/fnt_Title/fnt_Title.yy",},"frameH":40.0,"frameW":800.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":5.0,"name":"text_6454E288","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"LOGGING SYSTEM","wrap":true,"x":420.0,"y":20.0,},
      ],"depth":500,"effectEnabled":true,"effectType":null,"gridX":20,"gridY":20,"hierarchyFrozen":false,"inheritLayerDepth":false,"inheritLayerSettings":false,"inheritSubLayers":true,"inheritVisibility":true,"layers":[],"name":"Info_Logging","properties":[],"resourceType":"GMRAssetLayer","resourceVersion":"2.0","userdefinedDepth":false,"visible":false,},
    {"$GMRAssetLayer":"","%Name":"Info_Tasks","assets":[
        {"$GMRTextItem":"v3","%Name":"text_55A3A30A","alignment":0,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"fnt_Info","path":"fonts/fnt_Info/fnt_Info.yy",},"frameH":600.0,"frameW":840.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":5.0,"name":"text_55A3A30A","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"The workers system is used for performing long running tasks over many frames, whether running in the background using the free processing time or in the loading screen with gradually shown progress.\r\n\r\nThe workers system includes three main components:\r\n- the task processor, splitting the long running logic into finer steps\r\n- the task manager, interacting with the processor, reporting progress and allowing cancellation\r\n- the worker, keeping track of currently running tasks and managing how much time they should run for at a time\r\n\r\nThe workers system is showcased in the Counter Observer Demo, where a counter processor sums up many terms step by step and reports progress and cancellation/completion of the counting task.","wrap":true,"x":420.0,"y":80.0,},
        {"$GMRTextItem":"v3","%Name":"text_459DF9DD","alignment":0,"charSpacing":0.0,"colour":4292149119,"fontId":{"name":"fnt_Title","path":"fonts/fnt_Title/fnt_Title.yy",},"frameH":40.0,"frameW":800.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":5.0,"name":"text_459DF9DD","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"WORKERS SYSTEM","wrap":true,"x":420.0,"y":20.0,},
      ],"depth":600,"effectEnabled":true,"effectType":null,"gridX":20,"gridY":20,"hierarchyFrozen":false,"inheritLayerDepth":false,"inheritLayerSettings":false,"inheritSubLayers":true,"inheritVisibility":true,"layers":[],"name":"Info_Tasks","properties":[],"resourceType":"GMRAssetLayer","resourceVersion":"2.0","userdefinedDepth":false,"visible":false,},
    {"$GMRAssetLayer":"","%Name":"Info_Providers","assets":[
        {"$GMRTextItem":"v3","%Name":"text_29595246","alignment":0,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"fnt_Info","path":"fonts/fnt_Info/fnt_Info.yy",},"frameH":600.0,"frameW":840.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":5.0,"name":"text_29595246","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"The providers system is used for delivering various resources and dependencies.\r\n\r\nFor example, the dialogue system may ask for a player name or timer string. The provider then will determine how to obtain the requested value, and whether it should obtain a fixed value or generate one on the spot.\r\nLikewise, an enemy instance may request a behaviour struct to control its AI. Depending on the requested behaviour type, the provider will decide whether to deliver a pre-existing shared stateless behaviour or if it needs to generate a new stateful behaviour.\r\n\r\nThe providers system includes two main components:\r\n- the resolver, which determines how to obtain the requested value\r\n- the provider, which chooses the resolver based on the kind of the requested value\r\n\r\nThe providers system is showcased in the Shape Maker demo, where you can place various shape kinds with given size and colour. The resolver logic varies between different shape kinds.","wrap":true,"x":420.0,"y":80.0,},
        {"$GMRTextItem":"v3","%Name":"text_6A99076E","alignment":0,"charSpacing":0.0,"colour":4292149119,"fontId":{"name":"fnt_Title","path":"fonts/fnt_Title/fnt_Title.yy",},"frameH":40.0,"frameW":800.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":5.0,"name":"text_6A99076E","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"text":"PROVIDERS SYSTEM","wrap":true,"x":420.0,"y":20.0,},
      ],"depth":700,"effectEnabled":true,"effectType":null,"gridX":20,"gridY":20,"hierarchyFrozen":false,"inheritLayerDepth":false,"inheritLayerSettings":false,"inheritSubLayers":true,"inheritVisibility":true,"layers":[],"name":"Info_Providers","properties":[],"resourceType":"GMRAssetLayer","resourceVersion":"2.0","userdefinedDepth":false,"visible":false,},
    {"$GMRAssetLayer":"","%Name":"Graphics","assets":[
        {"$GMRSpriteGraphic":"v1","%Name":"graphic_2028CD36_1","animationSpeed":1.0,"colour":4294967295,"frozen":false,"headPosition":0.0,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"name":"graphic_2028CD36_1","resourceType":"GMRSpriteGraphic","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"spriteId":{"name":"spr_CimpliLogo","path":"sprites/spr_CimpliLogo/spr_CimpliLogo.yy",},"x":60.0,"y":20.0,},
        {"$GMRSpriteGraphic":"v1","%Name":"graphic_684CAB87_1","animationSpeed":1.0,"colour":4294967295,"frozen":false,"headPosition":0.0,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"name":"graphic_684CAB87_1","resourceType":"GMRSpriteGraphic","resourceVersion":"2.0","rotation":0.0,"scaleX":1.0,"scaleY":1.0,"spriteId":{"name":"spr_CimpliTitle","path":"sprites/spr_CimpliTitle/spr_CimpliTitle.yy",},"x":134.0,"y":20.0,},
        {"$GMRSpriteGraphic":"v1","%Name":"graphic_62478690","animationSpeed":1.0,"colour":4294967295,"frozen":false,"headPosition":0.0,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"name":"graphic_62478690","resourceType":"GMRSpriteGraphic","resourceVersion":"2.0","rotation":0.0,"scaleX":14.666667,"scaleY":12.0,"spriteId":{"name":"bg_Console","path":"sprites/bg_Console/bg_Console.yy",},"x":400.0,"y":0.0,},
      ],"depth":800,"effectEnabled":true,"effectType":null,"gridX":20,"gridY":20,"hierarchyFrozen":false,"inheritLayerDepth":false,"inheritLayerSettings":false,"inheritSubLayers":true,"inheritVisibility":true,"layers":[],"name":"Graphics","properties":[],"resourceType":"GMRAssetLayer","resourceVersion":"2.0","userdefinedDepth":false,"visible":true,},
    {"$GMRBackgroundLayer":"","%Name":"Background","animationFPS":30.0,"animationSpeedType":0,"colour":4294967295,"depth":900,"effectEnabled":true,"effectType":null,"gridX":32,"gridY":32,"hierarchyFrozen":false,"hspeed":0.0,"htiled":false,"inheritLayerDepth":false,"inheritLayerSettings":false,"inheritSubLayers":true,"inheritVisibility":true,"layers":[],"name":"Background","properties":[],"resourceType":"GMRBackgroundLayer","resourceVersion":"2.0","spriteId":{"name":"bg_Demo","path":"sprites/bg_Demo/bg_Demo.yy",},"stretch":false,"userdefinedAnimFPS":false,"userdefinedDepth":false,"visible":true,"vspeed":0.0,"vtiled":false,"x":0,"y":0,},
